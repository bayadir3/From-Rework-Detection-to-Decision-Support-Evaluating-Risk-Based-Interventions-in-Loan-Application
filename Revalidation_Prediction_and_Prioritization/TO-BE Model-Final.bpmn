        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>F_18I_19I</incoming>
      <outgoing>F_19I_15A</outgoing>
    </task>
    <task id="FlowElement1" name="DS1. Risk Prediction">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Predict repeated-rework risk at the first A_Incomplete using Logistic Regression.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E9DDF7"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>FlowElement5</incoming>
      <outgoing>FlowElement6</outgoing>
    </task>
    <task id="FlowElement2" name="DS2. Risk-Based Prioritization">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Rank applications by predicted risk and select cases within the defined review capacity.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E9DDF7"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>FlowElement6</incoming>
      <outgoing>FlowElement7</outgoing>
    </task>
    <task id="FlowElement4" name="DS3. Targeted Review">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Review selected applications to identify outstanding requirements and coordinate appropriate corrective actions.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E9DDF7"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>FlowElement8</incoming>
      <outgoing>FlowElement11</outgoing>
    </task>
    <startEvent id="Start" name="Start">
      <documentation/>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
