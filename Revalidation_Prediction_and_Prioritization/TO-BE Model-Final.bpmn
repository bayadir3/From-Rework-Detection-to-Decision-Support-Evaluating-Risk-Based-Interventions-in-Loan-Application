      <incoming>F_11_Out</incoming>
      <outgoing>F_Out_Cancel</outgoing>
      <outgoing>F_Out_Val</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="G_Val" name="Validation Outcome?" gatewayDirection="Diverging">
      <documentation>Observed validation outcomes: accepted, denied, or incomplete.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF"/>
            <bizagi:BizagiProperty name="borderColor" value="#000000"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>F_14B_Val</incoming>
      <outgoing>F_Val_Acc</outgoing>
      <outgoing>F_Val_Den</outgoing>
      <outgoing>F_Val_Inc</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="G_Prior" name="Repeated Rework? Detected?" gatewayDirection="Diverging">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Routing decision based on whether repeated validation rework has already occurred in the case history.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>FlowElement14</incoming>
      <outgoing>FlowElement12</outgoing>
      <outgoing>F_Prior_Yes</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="G_Ready" name="Ready for Revalidation?" gatewayDirection="Diverging">
      <documentation>Only cases that pass the completeness check proceed back to validation.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>F_19R_Ready</incoming>
      <outgoing>F_Ready_No</outgoing>
      <outgoing>F_Ready_Yes_New</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="FlowElement3" name="" gatewayDirection="Converging">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Routing decision based on whether repeated validation rework has already occurred in the case history.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>FlowElement10</incoming>
      <incoming>FlowElement11</incoming>
      <outgoing>FlowElement16</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="FlowElement13" name="Revalidation Required?" gatewayDirection="Diverging">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Determines whether further validation is required after the standard or targeted review pathway.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>FlowElement16</incoming>
      <outgoing>F_RevalReq_Yes</outgoing>
      <outgoing>F_RevalReq_No</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="FlowElement15" name="Selected for Targeted Review?" gatewayDirection="Diverging">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Determine whether the application was selected for additional review.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
