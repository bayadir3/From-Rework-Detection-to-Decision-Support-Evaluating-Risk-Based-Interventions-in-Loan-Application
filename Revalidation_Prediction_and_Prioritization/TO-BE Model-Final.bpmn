    <task id="N17I" name="17I. Rework History Check">
      <documentation>Review whether the case has already undergone a prior revalidation cycle. No specific automation technology is assumed.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E9DDF7"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>F_RevalReq_Yes</incoming>
      <outgoing>FlowElement14</outgoing>
    </task>
    <task id="N19R" name="19R. Revalidation Readiness Check">
      <documentation>Check whether the consolidated correction requirements have been addressed sufficiently for another validation attempt. Implementation is technology-neutral.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E9DDF7"/>
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>F_18R_19R</incoming>
      <outgoing>F_19R_Ready</outgoing>
    </task>
    <task id="N20R" name="20R. Resolve Remaining Rework Issues">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Resolve outstanding issues before repeating the consolidation and readiness check.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFE6CC"/>
            <bizagi:BizagiProperty name="borderColor" value="#C66A00"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>F_Ready_No</incoming>
      <outgoing>F_20R_18R</outgoing>
    </task>
    <task id="N18I" name="18I. Revalidate Application">
      <documentation>Revalidation step retained from the AS-IS incomplete-case recovery path.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFBE6"/>
            <bizagi:BizagiProperty name="borderColor" value="#000000"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>F_Ready_Yes_New</incoming>
      <incoming>FlowElement12</incoming>
      <outgoing>F_18I_19I</outgoing>
    </task>
    <task id="N19I" name="19I. Application Under Validation">
      <documentation>Application state during revalidation, retained from the AS-IS incomplete-case recovery path.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ADD8E6"/>
            <bizagi:BizagiProperty name="borderColor" value="#000000"/>
            <bizagi:BizagiProperty name="textColor" value="#000000"/>
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent"/>
            <bizagi:BizagiProperty name="textDirection" value="Horizontal"/>
