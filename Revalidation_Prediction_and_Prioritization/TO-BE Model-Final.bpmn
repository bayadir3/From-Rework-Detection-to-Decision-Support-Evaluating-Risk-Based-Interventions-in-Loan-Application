    <exclusiveGateway id="G_Sub" name="Submission Recorded?" gatewayDirection="Diverging">
      <documentation>Observed AS-IS routing variation retained for continuity.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
